# Copy to .env (git-ignored) and fill in.

# Tailscale auth key from the admin console (Settings > Keys). Use a reusable,
# tagged key (e.g. tag:tinyhippo) so the node rejoins after restarts and can be
# limited by ACLs. Only needed for the first login; the node state is then kept
# in the `tailscale` volume.
TS_AUTHKEY=

# Name of this machine on the tailnet; Max connects with ssh max@<TS_HOSTNAME>.
TS_HOSTNAME=tinyhippo-gpu

# Login name inside the container. It is baked into the image, so changing it
# needs a rebuild: docker compose -f gpu/dev/compose.yml up -d --build
DEV_USER=max
